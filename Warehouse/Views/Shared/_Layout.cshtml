<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="~/core/app.css" rel="stylesheet" />
    <title>@ViewData["Title"]</title>
</head>
<body>
    @{
        Button[] buttons = new[] {
            new Button(Icon.Settings, "Settings", nameof(SettingsController)),
            new Button(Icon.Overview, "Overview", nameof(OverviewController)),
            new Button(Icon.Income,   "Income",   nameof(IncomeController)),
            new Button(Icon.Store,    "Store",    nameof(StoreController)),
            new Button(Icon.Supply,   "Supply",   nameof(SupplyController)),
            new Button(Icon.Outcome,  "Outcome",  nameof(OutcomeController))
        };
        Button settingsButton = buttons.First(btn => btn.Title == "Settings");
        Button overviewButton = buttons.First(btn => btn.Title == "Overview");
    }
    <div class="wh-application">
        <div class="flex-fill">
            <div class="wh-root-container">
                <div class="wh-title-panel">
                    <div class="wh-title">
                        <a asp-controller="@overviewButton.Controller"
                           asp-action="@overviewButton.Action">
                            <wh-icon name="Package"></wh-icon><span>Warehouse</span>
                        </a>
                    </div>
                    <div class="d-lg-none">
                        @{
                            <wh-button icon="@settingsButton.Icon"
                                       size="Medium"
                                       controller="@settingsButton.Controller"
                                       action="@settingsButton.Action">
                            </wh-button>
                        }
                    </div>
                </div>
                <div class="wh-main-container">
                    <main role="main">
                        @RenderBody()
                    </main>
                </div>
                <div class="wh-mobile-panel">
                    @foreach (var button in buttons.Except(new[] { settingsButton }))
                    {
                        <wh-button icon="@button.Icon"
                                   size="Large"
                                   controller="@button.Controller"
                                   action="@button.Action">
                        </wh-button>
                    }
                </div>
            </div>
        </div>
        <div>
            <div class="wh-desktop-panel">
                @foreach (var button in buttons)
                {
                    <wh-button title="@button.Title"
                               icon="@button.Icon"
                               size="Small"
                               controller="@button.Controller"
                               action="@button.Action">
                    </wh-button>
                }
            </div>
        </div>
    </div>
    <script src="~/core/app.js" asp-append-version="true"></script>
</body>
</html>
