<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
</head>
<body>
    @{
        Button[] buttons = new[] {
            new Button(nameof(SettingsController)) { Title = "Settings", Icon = "settings"     },
            new Button(nameof(OverviewController)) { Title = "Overview", Icon = "layout"       },
            new Button(nameof(IncomeController))   { Title = "Income",   Icon = "log-in"       },
            new Button(nameof(StoreController))    { Title = "Store",    Icon = "box"          },
            new Button(nameof(SupplyController))   { Title = "Supply",   Icon = "shopping-bag" },
            new Button(nameof(OutcomeController))  { Title = "Outcome",  Icon = "log-out"      },
        };
    }
    @functions {
        #pragma warning disable 1998
        private async Task RenderButton(Button button, float size, bool hasTitle)
        {
            <a type="button"
               class="btn btn-sm btn-outline-primary"
               asp-controller="@button.Controller"
               asp-action="Index">
                <i data-feather="@button.Icon"
                   width="@(size)rem"
                   height="@(size)rem"></i>
                @if (hasTitle)
                {
                    <span class="align-middle">@button.Title</span>
                }
            </a>
        }
        #pragma warning restore 1998
    }
    <div class="wh-application">
        <div class="flex-fill">
            <div class="wh-root-container">
                <div class="wh-title-panel">
                    <div class="wh-title">
                        <a asp-controller="@buttons[0].Controller"
                           asp-action="Index">
                            <i data-feather="package"></i><span>Warehouse</span>
                        </a>
                    </div>
                    <div class="d-lg-none">
                        @{
                            await RenderButton(@buttons[0], 1.5f, false); // add settings button
                        }
                    </div>
                </div>
                <div class="wh-main-container">
                    <main role="main">
                        @RenderBody()
                    </main>
                </div>
                <div class="wh-mobile-panel">
                    @foreach (var button in buttons.Skip(1)) // skip settings button
                    {
                        await RenderButton(button, 1.8f, false);
                    }
                </div>
            </div>
        </div>
        <div>
            <div class="wh-desktop-panel">
                @foreach (var button in buttons)
                {
                    await RenderButton(button, 1.2f, true);
                }
            </div>
        </div>
    </div>
    <script src="~/core/app.js" asp-append-version="true"></script>
</body>
</html>
