<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
</head>
<body>
    @{
        Button[] buttons = new[] {
            new Button("Settings", "settings",           nameof(SettingsController)),
            new Button("Overview", "layout-board",       nameof(OverviewController)),
            new Button("Income",   "transfer-in",        nameof(IncomeController)),
            new Button("Store",    "building-warehouse", nameof(StoreController)),
            new Button("Supply",   "forklift",           nameof(SupplyController)),
            new Button("Outcome",  "transfer-out",       nameof(OutcomeController))
        };
    }
    @functions {
        #pragma warning disable 1998
        private async Task RenderButton(Button button, Size size, bool hasTitle)
        {
            string iconClass = size.GetIconClass();
            <a type="button"
               class="btn btn-sm btn-outline-primary"
               asp-controller="@button.Controller"
               asp-action="Index">
                <i class="@iconClass @button.Icon"></i>
                @if (hasTitle)
                {
                    <span class="align-middle">@button.Title</span>
                }
            </a>
        }
        #pragma warning restore 1998
    }
    <div class="wh-application">
        <div class="flex-fill">
            <div class="wh-root-container">
                <div class="wh-title-panel">
                    <div class="wh-title">
                        <a asp-controller="@buttons[0].Controller"
                           asp-action="Index">
                            <i class="wh-icon icon-package"></i><span>Warehouse</span>
                        </a>
                    </div>
                    <div class="d-lg-none">
                        @{
                            await RenderButton(@buttons[0], Size.Medium, false); // add settings button
                        }
                    </div>
                </div>
                <div class="wh-main-container">
                    <main role="main">
                        @RenderBody()
                    </main>
                </div>
                <div class="wh-mobile-panel">
                    @foreach (var button in buttons.Skip(1)) // skip settings button
                    {
                        await RenderButton(button, Size.Large, false);
                    }
                </div>
            </div>
        </div>
        <div>
            <div class="wh-desktop-panel">
                @foreach (var button in buttons)
                {
                    await RenderButton(button, Size.Small, true);
                }
            </div>
        </div>
    </div>
    <script src="~/core/app.js" asp-append-version="true"></script>
</body>
</html>
